# MongoDB connection string, including the database name.
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/email-automation

# Gmail account to watch and send from. Needs 2-Step Verification, then create an
# app password at https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/poll.
CRON_SECRET=generate-with-openssl-rand-hex-32

# Password for the web UI. Required in production; leave empty locally to skip the login.
APP_PASSWORD=
